{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "나날노트: 사용자가 고른 자료 폴더(USB 포함)를 읽고 쓰기, 폴더 고르기 창",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    { "identifier": "fs:scope", "allow": [{ "path": "**" }, { "path": "**/.webview/**" }] }
  ]
}
