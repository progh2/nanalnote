{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "나날노트",
  "mainBinaryName": "nanalnote",
  "version": "1.0.0",
  "identifier": "io.github.progh2.nanalnote",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "나날이 쓰는 교사수첩",
    "longDescription": "수업일지, 업무일지, 학생 상담·출결, 학사일정을 한곳에서 관리하는 교사수첩. 원 쌔미노트에서 영감을 받아 만들었습니다.",
    "publisher": "progh2",
    "homepage": "https://github.com/progh2/nanalnote",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "Korean",
          "English"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": [
          "ko-KR"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}